{
  "name": "potber-api",
  "version": "3.5.0",
  "description": "A modern JSON API for forum.mods.de",
  "author": "https://spuxx.dev",
  "private": true,
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "NODE_OPTIONS='--enable-source-maps' nest start",
    "start:dev": "NODE_OPTIONS='--enable-source-maps' nest start --watch",
    "start:debug": "NODE_OPTIONS='--enable-source-maps' nest start --debug --watch",
    "start:prod": "NODE_OPTIONS='--enable-source-maps' node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "types": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:debug": "node --inspect-brk ./node_modules/jest/bin/jest.js --runInBand",
    "update": "npx npm-check-updates -u"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@nanogiants/nestjs-swagger-api-exception-decorator": "^1.7.4",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@willsoto/nestjs-prometheus": "^6.1.0",
    "axios": "^1.19.0",
    "class-transformer": "^0.5.1",
    "class-validator": "0.15.1",
    "fast-xml-parser": "^5.10.1",
    "he": "^1.2.0",
    "nest-winston": "^1.10.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.1.29",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "24.12.0",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "@types/xmldom": "^0.1.34",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "brace-expansion": "^5.0.9",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "30.4.2",
    "minimatch": "^10.2.6",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3"
  }
}
